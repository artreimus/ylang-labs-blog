# ========== COMMENT SYSTEMS ==========
# Choose one of the following commenting systems:

# 1. Giscus (GitHub Discussions-based)
# Visit https://giscus.app to get your Giscus IDs
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# 2. Utterances (GitHub Issues-based)
NEXT_PUBLIC_UTTERANCES_REPO=

# 3. Disqus
NEXT_PUBLIC_DISQUS_SHORTNAME=


# ========== NEWSLETTER PROVIDERS ==========
# Choose one of the following newsletter services:

# 1. Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

# 2. Buttondown
BUTTONDOWN_API_KEY=

# 3. Convertkit
CONVERTKIT_API_KEY=
# Get form ID: curl https://api.convertkit.com/v3/forms?api_key=<your_public_api_key>
CONVERTKIT_FORM_ID=

# 4. Klaviyo
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# 5. Revue
REVUE_API_KEY=

# 6. EmailOctopus
# Create API key at https://emailoctopus.com/api-documentation
EMAILOCTOPUS_API_KEY=
# List ID can be found in the URL as a UUID after clicking a list on https://emailoctopus.com/lists
# or the settings page of your list https://emailoctopus.com/lists/{UUID}/settings
EMAILOCTOPUS_LIST_ID=

# 7. Beehiiv
# Create API key at https://developers.beehiiv.com/docs/v2/bktd9a7mxo67n-create-an-api-key
BEEHIVE_API_KEY=
BEEHIVE_PUBLICATION_ID=

# ========== GOOGLE ANALYTICS ==========
NEXT_GOOGLE_ANALYTICS_ID=

# ========== WEB3 FORMS ==========
# Server-only. Never prefix the access key with NEXT_PUBLIC_.
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_ENDPOINT=https://api.web3forms.com/submit

# Local browser tests may use a loopback WEB3FORMS_ENDPOINT only with E2E_TEST=true.
# Never enable E2E_TEST in a Vercel environment.
E2E_TEST=false

# ========== VERCEL BLOB ASSETS ==========
# Store IDs are safe configuration. Keep both read/write tokens server-side and out of Vercel builds.
BLOB_PUBLIC_STORE_ID=
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_SOURCES_STORE_ID=
BLOB_SOURCES_READ_WRITE_TOKEN=

# Exact public origin and immutable upload namespace used by next/image and CSP.
# Example: https://store123.public.blob.vercel-storage.com
BLOB_PUBLIC_ORIGIN=
BLOB_PUBLIC_PATH_PREFIX=/public/**

# Keep true/omitted during the staged migration. Set false only after every published ID is manifested.
ASSET_LOCAL_FALLBACK=true
