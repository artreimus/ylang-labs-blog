{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev --webpack",
    "build": "cross-env INIT_CWD=$PWD next build --webpack && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "assets:inventory": "node ./scripts/assets/inventory.mjs",
    "assets:publish": "node ./scripts/assets/publish.mjs",
    "assets:validate": "node ./scripts/assets/validate.mjs",
    "audit:prod": "node ./scripts/security/check-production-audit.mjs",
    "bundles:validate": "node ./scripts/bundles/validate.mjs",
    "content:generate": "contentlayer2 build",
    "lint": "eslint app components lib layouts scripts tests contentlayer.config.ts next.config.js tailwind.config.js",
    "typecheck": "cross-env CONTENTLAYER_WRITE_ARTIFACTS=false contentlayer2 build && tsc --noEmit --incremental false",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@headlessui/react": "2.2.10",
    "@hookform/resolvers": "^4.1.0",
    "@next/bundle-analyzer": "16.2.10",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.6",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tabler/icons-react": "^3.34.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.13",
    "body-scroll-lock": "^4.0.0-beta.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "contentlayer2": "0.5.8",
    "esbuild": "0.20.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "image-size": "1.0.0",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.16.0",
    "motion": "^12.23.12",
    "next": "16.2.10",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.19",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-phone-number-input": "^3.4.12",
    "reactflow": "^11.11.4",
    "reading-time": "1.5.0",
    "recharts": "^3.9.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.0",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-html": "^16.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.12",
    "@types/react": "^19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vercel/blob": "^2.6.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^13.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "pnpm exec eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@>=1.13.0 <1.14.4": "1.14.4",
      "form-data@<2.5.6": "2.5.6",
      "minimatch@<3.1.4": "3.1.4",
      "next-themes": "0.4.6",
      "picomatch@<2.3.2": "2.3.2",
      "protobufjs@<=7.6.2": "7.6.5"
    }
  }
}
